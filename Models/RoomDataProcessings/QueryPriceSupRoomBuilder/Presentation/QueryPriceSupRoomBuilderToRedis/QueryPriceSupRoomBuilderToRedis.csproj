<Project Sdk="Microsoft.NET.Sdk;Microsoft.NET.Sdk.Publish">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..\..\..\..\MengtuV</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Configs\nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VBase.AppMetrics" Version="1.0.8" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Base\Shared\Infrastructure\VBaseFramework.Core\VBaseFramework.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Base\Shared\Infrastructure\VBaseFramework.ServiceDefaults\VBaseFramework.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Application\QueryPriceSupRoomBuilder\QueryPriceSupRoomBuilder.csproj" />
    <ProjectReference Include="..\..\..\..\RoomMatchings\Core\Application\RoomMatch.Core\RoomMatch.Core.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Infrastructure.QueryPriceSupRoomBuilder\Infrastructure.QueryPriceSupRoomBuilder.csproj" />
    <ProjectReference Include="..\..\..\..\..\Providers\Infrastructure.HTTP.QueryPrice\Infrastructure.HTTP.QueryPrice.csproj" />
    <ProjectReference Include="..\..\..\..\..\Providers\Infrastructure.Redis.TriggerQueue\Infrastructure.Redis.TriggerQueue.csproj" />
    <ProjectReference Include="..\..\..\..\..\Providers\Infrastructure.Redis.SupRoomInfo.DirectPriceDiscovery\Infrastructure.Redis.SupRoomInfo.DirectPriceDiscovery.csproj" />
    <ProjectReference Include="..\..\..\..\..\Providers\Infrastructure.Sql.RoomMapping\Infrastructure.Sql.RoomMapping.csproj" />
    <ProjectReference Include="..\..\..\..\RoomMatchings\Core\Infrastructure\Infrastructure.RoomMatchApp\Infrastructure.RoomMatchApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MengTu.Connectmate.Client">
      <HintPath>..\..\..\..\..\999.DLL\Connectmate\net10.0\MengTu.Connectmate.Client.dll</HintPath>
    </Reference>
