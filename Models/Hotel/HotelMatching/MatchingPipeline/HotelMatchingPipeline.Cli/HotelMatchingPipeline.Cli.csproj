  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\BaseFrameworks\VBaseFramework.Core\VBaseFramework.Core.csproj" />
    <ProjectReference Include="..\..\..\..\..\BaseFrameworks\VBaseFramework.ServiceDefaults\VBaseFramework.ServiceDefaults.csproj" />
    <ProjectReference Include="..\HotelMatchingPipeline.App\HotelMatchingPipeline.App.csproj" />
    <ProjectReference Include="..\HotelMatchingPipeline.Infra\HotelMatchingPipeline.Infra.csproj" />
    <ProjectReference Include="..\..\..\..\..\Providers\Infrastructure.Sql.RoomMapping\Infrastructure.Sql.RoomMapping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MengTu.Connectmate.Client">
      <HintPath>..\..\..\..\..\999.DLL\Connectmate\net10.0\MengTu.Connectmate.Client.dll</HintPath>
    </Reference>
    <Reference Include="VBaseFramework.ApiSecurity.ClientSdk">
      <HintPath>..\..\..\..\..\999.DLL\Connectmate\net10.0\VBaseFramework.ApiSecurity.ClientSdk.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Configs\nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
