{
  "profiles": {
    "SupplierStaticDataAppTester": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "supplier-static-data",
      "applicationUrl": "http://localhost:5126",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/supplier-static-data",
      "httpPort": 5126,
      "useSSL": false,
      "environmentVariables": {
        "ASPNETCORE_URLS": "http://0.0.0.0:5126",
        "ASPNETCORE_HTTP_PORTS": "5126"
      }
    }
  }
}
