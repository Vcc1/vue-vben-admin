# 此阶段用于生成服务项�?
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["Models/SupRoomInfo/Ingestion/SupRoomInfoRedisToSql.Cli/SupRoomInfoRedisToSql.Cli.csproj", "Models/SupRoomInfo/Ingestion/SupRoomInfoRedisToSql.Cli/"]
