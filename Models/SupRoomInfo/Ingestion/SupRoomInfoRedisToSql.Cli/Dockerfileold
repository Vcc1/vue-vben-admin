WORKDIR "/src/Models/SupRoomInfo/Ingestion/SupRoomInfoRedisToSql.Cli"
RUN dotnet build "./SupRoomInfoRedisToSql.Cli.csproj" -c $BUILD_CONFIGURATION -o /app/build

# 此阶段用于发布要复制到最终阶段的服务项目
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./SupRoomInfoRedisToSql.Cli.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

# 此阶段在生产中使用，或在常规模式下从 VS 运行时使�?在不使用调试配置时为默认�?
FROM base AS final
