FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
USER $APP_UID
WORKDIR /app


# �˽׶��������ɷ�����??
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["Models/Room/RoomMatchings/Core/RoomMatching.Cli/RoomMatching.Cli.csproj", "Models/Room/RoomMatchings/Core/RoomMatching.Cli/"]
