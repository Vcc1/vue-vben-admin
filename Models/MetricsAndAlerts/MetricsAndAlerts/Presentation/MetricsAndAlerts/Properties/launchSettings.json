{
    "profiles": {
        "MetricsAndAlerts": {
            "commandName": "Project",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "dotnetRunMessages": true,
            "applicationUrl": "http://localhost:5010",
            "httpPort": 5010,
            "useSSL": false,
            "publishAllPorts": false
        },
        "Container (Dockerfile)": {
            "commandName": "Docker",
            "applicationUrl": "http://localhost:5010",
            "containerRunArguments": "-p 5010:5010",
            "useSSL": false,
            "publishAllPorts": false

        }

    }
}