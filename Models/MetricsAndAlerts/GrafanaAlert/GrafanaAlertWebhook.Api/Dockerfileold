# 请参�?https://aka.ms/customizecontainer 以了解如何自定义调试容器，以�?Visual Studio 如何使用�?Dockerfile 生成映像以更快地进行调试�?

# 此阶段用于在快速模�?默认为调试配�?下从 VS 运行�?
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
USER $APP_UID
WORKDIR /app
EXPOSE 5000


# 此阶段用于生成服务项�?
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["Models/MetricsAndAlerts/GrafanaAlert/GrafanaAlertWebhook.Api/GrafanaAlertWebhook.Api.csproj", "Models/MetricsAndAlerts/GrafanaAlert/GrafanaAlertWebhook.Api/"]
COPY ["Models/Base/Shared/VBaseFramework.ServiceDefaults.Infra/VBaseFramework.ServiceDefaults.Infra.csproj", "Models/Base/Shared/VBaseFramework.ServiceDefaults.Infra/"]
COPY ["Models/Base/Shared/VBaseFramework.Core.Infra/VBaseFramework.Core.Infra.csproj", "Models/Base/Shared/VBaseFramework.Core.Infra/"]
COPY ["Models/MetricsAndAlerts/GrafanaAlert/GrafanaAlert.App/GrafanaAlert.App.csproj", "Models/MetricsAndAlerts/GrafanaAlert/GrafanaAlert.App/"]
COPY ["Models/MetricsAndAlerts/GrafanaAlert/GrafanaAlert.Infra/Infrastructure.GrafanaAlert.App.csproj", "Models/MetricsAndAlerts/GrafanaAlert/GrafanaAlert.Infra/"]
COPY ["Providers/Infrastructure.HTTP.WorkWechatAlert/Infrastructure.HTTP.WorkWechatAlert.csproj", "Providers/Infrastructure.HTTP.WorkWechatAlert/"]
RUN dotnet restore "./Models/MetricsAndAlerts/GrafanaAlert/GrafanaAlertWebhook.Api/GrafanaAlertWebhook.Api.csproj"
COPY . .
WORKDIR "/src/Models/MetricsAndAlerts/GrafanaAlert/GrafanaAlertWebhook.Api"
RUN dotnet build "./GrafanaAlertWebhook.Api.csproj" -c $BUILD_CONFIGURATION -o /app/build

# 此阶段用于发布要复制到最终阶段的服务项目
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./GrafanaAlertWebhook.Api.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

# 此阶段在生产中使用，或在常规模式下从 VS 运行时使�?在不使用调试配置时为默认�?
FROM base AS final
WORKDIR /app
USER root
# 设置时区为东八区（Asia/Shanghai），并清�?apt 缓存
ENV TZ=Asia/Shanghai DEBIAN_FRONTEND=noninteractive
ENV ASPNETCORE_URLS=http://0.0.0.0:5000
RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=publish /app/publish .
USER $APP_UID
ENTRYPOINT ["dotnet", "GrafanaAlertWebhook.Api.dll"]
