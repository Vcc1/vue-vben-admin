{
    "$schema": "./appsettings.schema.json",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "AppMetrics": {
        "ProgramId": "TestMetrics",
        "ServerId": "萌兔-张巍",
        "Environment": "Dev",
        "InstanceId": "TestMetrics-dev",
        "AdditionalMeterNames": [
            "TestMetrics.GoodsMetrics"
        ]
    },
    "OpenTelemetry": {
        "OtlpEndpoint": "http://connapi.v.m-tu.com:4318/v1/metrics",
        "OtlpProtocol": "HttpProtobuf",
        "ExportIntervalMilliseconds": 10000,
        "ExportTimeoutMilliseconds": 10000
    }
}
