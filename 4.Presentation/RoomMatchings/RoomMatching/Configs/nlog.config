<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <targets>
        <target name="null" xsi:type="Null" />
        <target name="console" xsi:type="Console" layout="${longdate}|${level}|${logger}|${message} ${exception}" />

        <target name="file" xsi:type="File"
            fileName="logs/${shortdate}.log"
            layout="${longdate} ${level:uppercase=true} ${logger} ${message} ${exception:format=toString}"
            encoding="utf-8"
            keepFileOpen="false"
            concurrentWrites="true"
            archiveFileName="logs/archive/${shortdate}.{#####}.log"
            archiveEvery="Day"
            maxArchiveFiles="7"
            archiveNumbering="Rolling" />
    </targets>
    <rules>
        <!--EFSql日志-->
        <!--<logger name="VBaseFramework.Core.EF.Log.EFLogger" minlevel="Error" writeTo="console"  final="true"/>
        <logger name="VBaseFramework.Core.EF.Log.EFLogger" minlevel="Trace" writeTo="null"  final="true"/>-->
        <!--EFSql日志-->  
        <logger name="System.Net.Http.*" minlevel="Trace" writeTo="null"  final="true"/>
        <logger name="VBaseFramework.Core.EF.Log.EFLogger" minlevel="Error" writeTo="console"  final="true"/>
        <logger name="VBaseFramework.Core.EF.Log.EFLogger" minlevel="Trace" writeTo="null"  final="true"/>
        <!--全局兜底日志-->
        <logger name="*" minlevel="Trace" writeTo="console" />
    </rules>


    <!--    
            日志等级从高到低如下：
            Critical    致命错误，程序无法继续运行（如系统崩溃）
            Error       错误事件，一般是程序逻辑异常（如捕获到异常）
            Warning     警告事件，可能不是错误但需要注意（如配置缺失）
            Information 普通信息，系统运行的正常状态（如启动、关闭）
            Debug       调试信息，开发阶段使用，包含细节（如变量值）
            Trace       跟踪信息，最详细的日志，用于诊断（如函数调用链）
    -->
</nlog>