{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./appsettings.schema.json",
  "title": "SupRoomInfoRedisToSql appsettings schema",
  "type": "object",
  "properties": {
    "SupRoomInfoIngestion": {
      "$ref": "#/$defs/SupRoomInfoIngestion"
    },
    "AppMetrics": {
      "$ref": "#/$defs/AppMetrics"
    },
    "OpenTelemetry": {
      "$ref": "#/$defs/OpenTelemetry"
    }
  },
  "$defs": {
    "SupRoomInfoIngestion": {
      "type": "object",
      "properties": {
        "FetchBatchSize": {
          "type": "integer",
          "minimum": 1
        },
        "WriteBatchSize": {
          "type": "integer",
          "minimum": 1
        },
        "IdleDelaySeconds": {
          "type": "integer",
          "minimum": 1
        },
        "MetricsLogIntervalSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ListKey": {
          "type": "string"
        },
        "SetKeyPrefix": {
          "type": "string"
        },
        "SetSupIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "SetFetchBatchSize": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "AppMetrics": {
      "type": "object",
      "description": "应用指标基础标识配置。",
      "properties": {
        "ProgramId": {
          "type": "string",
          "description": "程序名称，对应 AppMetrics 的服务名。"
        },
        "ServerId": {
          "type": "string",
          "description": "服务器或节点标识。"
        },
        "Environment": {
          "type": "string",
          "description": "运行环境名称。"
        },
        "InstanceId": {
          "type": "string",
          "description": "实例标识。留空时启动后自动生成，固定值时可避免后端识别为新时序。"
        }
      },
      "additionalProperties": true
    },
    "OpenTelemetry": {
      "type": "object",
      "description": "OpenTelemetry 指标导出配置。",
      "properties": {
        "OtlpEndpoint": {
          "type": "string",
          "description": "OTLP 导出地址。",
          "examples": [
            "http://localhost:4318/v1/metrics"
          ]
        },
        "OtlpProtocol": {
          "type": "string",
          "description": "OTLP 导出协议。",
          "enum": [
            "Grpc",
            "HttpProtobuf"
          ]
        },
        "ExportIntervalMilliseconds": {
          "type": "integer",
          "description": "导出间隔，单位毫秒。",
          "minimum": 1000
        },
        "ExportTimeoutMilliseconds": {
          "type": "integer",
          "description": "导出超时，单位毫秒。",
          "minimum": 1000
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
