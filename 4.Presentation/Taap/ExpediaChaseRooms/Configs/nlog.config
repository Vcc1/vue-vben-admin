<?xml version="1.0" encoding="utf-8" ?>
<nlog autoReload="true"  xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <targets>
        <target name="log_file" xsi:type="AsyncWrapper">
            <target xsi:type="File"
                    fileName="${basedir}/logs/${shortdate}/${logger}-${level}.txt"
                    layout="${longdate} ${scopeproperty:ActionId2} ${scopeproperty:ClientId} ${message} ${onexception:${exception:format=message} ${newline} ${stacktrace} ${newline}}"
                    archiveFileName="${basedir}/logs/${shortdate}/${logger}-${level}-{#####}.txt"
                    archiveAboveSize="102400"
                    archiveNumbering="Sequence"
                    concurrentWrites="true"
                    keepFileOpen="false" />
        </target>
        <target name="log_console" xsi:type="Console"
                layout="${logger}-${level}-${longdate} ${scopeproperty:ActionId2} ${scopeproperty:ClientId} ${message} ${onexception:${exception:format=message} ${newline} ${stacktrace} ${newline}}" />
        <target name="log_file_hour" xsi:type="AsyncWrapper">
            <target xsi:type="File"
                    fileName="${basedir}/logs/${shortdate}/${logger}-${level}-${hour}.txt"
                    layout="${longdate} ${scopeproperty:ActionId2} ${scopeproperty:ClientId} ${message} ${onexception:${exception:format=message} ${newline} ${stacktrace} ${newline}}"
                    archiveFileName="${basedir}/logs/${shortdate}/${logger}-${level}-${hour}-{#####}.txt"
                    archiveAboveSize="102400"
                    archiveNumbering="Sequence"
                    concurrentWrites="true"
                    keepFileOpen="false" />
        </target>
        <target name="all_log" xsi:type="AsyncWrapper">
            <target xsi:type="File"
                    fileName="${basedir}/logs/${shortdate}/all-${hour}.txt"
                    layout="${longdate} ${level} ${scopeproperty:ActionId2} ${scopeproperty:ClientId}  ${message} ${onexception:${exception:format=message} ${newline} ${stacktrace} ${newline}}"
                    archiveFileName="${basedir}/logs/${shortdate}/all-${hour}-{#####}.txt"
                    archiveAboveSize="102400"
                    archiveNumbering="Sequence"
                    concurrentWrites="true"
                    keepFileOpen="false" />
        </target>
        <target name="microsoft_log_file" xsi:type="AsyncWrapper">
            <target xsi:type="File"
                    fileName="${basedir}/logs/${shortdate}/microsoft-${hour}.txt"
                    layout="${logger}-${level} ${longdate} ${scopeproperty:ActionId2} ${scopeproperty:ClientId} ${message} ${onexception:${exception:format=message} ${newline} ${stacktrace} ${newline}}"
                    archiveFileName="${basedir}/logs/${shortdate}/microsoft-${hour}-{#####}.txt"
                    archiveAboveSize="102400"
                    archiveNumbering="Sequence"
                    concurrentWrites="true"
                    keepFileOpen="false" />
        </target>
    </targets>

    <!--规则配置,final - 最终规则匹配后不处理任何规则-->
    <rules>
        <!-- 命中microsoft.*的日志只写microsoft_log_file，并停止继续匹配 -->
        <logger name="Microsoft.*" levels="Debug,Info,Error,Trace" minlevel="Debug" writeTo="microsoft_log_file" final="true" />
        <logger name="VBaseFramework.Core.EF.Log.*" levels="Debug,Info,Error,Trace" minlevel="Debug" writeTo="log_file" final="true" />
        <logger name="System.Net.Http.HttpClient.*" levels="Debug,Info,Error,Trace" minlevel="Debug" writeTo="log_file" final="true" />
        <logger name="Infrastructure.Redis.SupRoomInfo.SupRoomInfoDBContext" levels="Trace" writeTo="log_file_hour" final="true" />
        <!-- 其他日志写到log_file -->
        <logger name="*" levels="Debug,Info,Error,Trace" minlevel="Debug" writeTo="log_file,log_console" />
    </rules>
</nlog>