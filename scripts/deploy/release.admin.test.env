# ===== admin (MengtuAdmin) 前端 · 测试服务器 (test) =====
# 命令：powershell -ExecutionPolicy Bypass -File scripts/deploy/build-and-push.ps1 -App admin -Target test
# 测试机 192.168.1.130：5100=Admin.Host 后端/OIDC，5101=Admin 前端

# ----- 镜像 -----
DOCKER_REGISTRY="dockerhub.v.m-tu.com"
IMAGE_NAME="web-adminui-test"
VERSION=""
TAG_TIME_FORMAT="yyyyMMdd-HHmmss"
EXTRA_TAGS="test"
PUSH="true"

# ----- 本地 vue app -----
APP_DIR="apps/admin"
APP_PKG="@vben/admin"

# ----- 前端构建参数 -----
# ！！待确认：测试 API base 是否为 http://192.168.1.130:5100/api ！！
VITE_GLOB_API_URL="http://192.168.1.130:5100/api"
VITE_OIDC_AUTHORITY=""
VITE_OIDC_CLIENT_ID=""
VITE_OIDC_REDIRECT_URI=""
