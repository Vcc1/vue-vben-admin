Port 22
ListenAddress 0.0.0.0
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
AllowUsers codex
X11Forwarding no
AllowAgentForwarding no
PermitTunnel no
UsePAM no
HostKey /var/lib/codex/ssh-hostkeys/ssh_host_ed25519_key
SetEnv HTTP_PROXY=http://192.168.1.43:7890
SetEnv HTTPS_PROXY=http://192.168.1.43:7890
SetEnv http_proxy=http://192.168.1.43:7890
SetEnv https_proxy=http://192.168.1.43:7890
SetEnv NO_PROXY=localhost,127.0.0.1,192.168.1.0/24
SetEnv no_proxy=localhost,127.0.0.1,192.168.1.0/24
