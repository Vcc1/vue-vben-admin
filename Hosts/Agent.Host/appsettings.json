{
  "ConnectionStrings": {
    "RoomMapping": ""
  },
  "Connectmate": {
    "SkipRemoteConfiguration": false,
    "Client": {
      "PollIntervalSeconds": 60,
      "UserAgent": "Agent.Host",
      "IsInternalNetwork": false,
      "Subscriptions": [
        {
          "InstanceCode": "RoomMapping",
          "EnvCode": "prod"
        }
      ]
    }
  },
  "AgentPlatform": {
    "Storage": {
      "RootPath": "App_Data/agent-conversations",
      "BusinessRootPath": "App_Data/hotel-business"
    },
    "OpenAI": {
      "Model": "gpt-5.6-sol",
      "EnableWebSearch": true,
      "NetworkTimeoutSeconds": 600,
      "MaxRetries": 1,
      "SessionTtlMinutes": 120
    }
  },
  "HotelBusiness": {
    "Storage": {
      "RootPath": "App_Data/hotel-business"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
