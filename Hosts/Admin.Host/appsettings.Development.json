{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OidcServer": {
    "AdminLoginUrl": "http://localhost:5101/auth/login",
    "SigningKey": {
      "Type": "rsa-pfx",
      "PfxPath": "data/oidc-keys/oidc-signing.pfx"
    }
  },
  "AdminIdentity": {
    "StepUp": {
      "LogCodeForDevelopment": true
    }
  },
  "Cors": {
    "AllowedOrigins": [ "*" ]
  }
}
