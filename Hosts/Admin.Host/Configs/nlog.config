<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="Logs/nlog-internal.log">
  <targets>
    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />
    <target xsi:type="File" name="log_file"
            fileName="Logs/${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />
  </targets>
  <rules>
    <!-- 框架噪音：SQL 命令、EF 生命周期、ASP.NET 请求流水、健康检查等只保留 Warning 以上 -->
    <logger name="Microsoft.EntityFrameworkCore.*" maxlevel="Info" final="true" />
    <logger name="Microsoft.AspNetCore.*" maxlevel="Info" final="true" />
    <logger name="Microsoft.Extensions.Diagnostics.HealthChecks.*" maxlevel="Info" final="true" />
    <logger name="Microsoft.Extensions.Http.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="MengTu.Connectmate.Client.*" maxlevel="Info" final="true" />

    <!-- 应用日志 Info 以上写入控制台和文件 -->
    <logger name="*" minlevel="Info" writeTo="console,log_file" />
  </rules>
</nlog>
