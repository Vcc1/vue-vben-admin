# ===== paycardhub 前端 · 测试服务器 (test) =====
# 命令：powershell -ExecutionPolicy Bypass -File scripts/deploy/build-and-push.ps1 -App paycardhub -Target test
# 测试机 192.168.1.130，端口约定：5200=PayCardHub.Api 5201=paycardhub前端 5100=Admin.Host OIDC 5101=Admin前端

# ----- 镜像 -----
DOCKER_REGISTRY="dockerhub.v.m-tu.com"
IMAGE_NAME="paycardhub-web-test"
VERSION=""
TAG_TIME_FORMAT="yyyyMMdd-HHmmss"
EXTRA_TAGS="test"
PUSH="true"

# ----- 本地 vue app -----
APP_DIR="apps/paycardhub"
APP_PKG="@vben/paycardhub"

# ----- 前端构建参数（镜像是 production 构建=history 路由，回调为干净 URL）-----
VITE_GLOB_API_URL="http://192.168.1.130:5200"
VITE_OIDC_AUTHORITY="http://192.168.1.130:5100"
VITE_OIDC_CLIENT_ID="paycardhub"
VITE_OIDC_REDIRECT_URI="http://192.168.1.130:5201/auth/callback"
