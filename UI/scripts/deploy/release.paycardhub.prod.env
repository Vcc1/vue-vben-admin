# ===== paycardhub 前端 · 正式服务器 (prod) =====
# 命令：powershell -ExecutionPolicy Bypass -File scripts/deploy/build-and-push.ps1 -App paycardhub -Target prod

# ----- 镜像（远端路径 / 镜像名 / 版本，均可配）-----
# 远端仓库地址（不含镜像名与标签；不能带 http:// 前缀）
DOCKER_REGISTRY="dockerhub.v.m-tu.com"
# 镜像名
IMAGE_NAME="paycardhub-web"
# 版本号：留空=用时间戳自动生成；填了=用固定版本作标签（如 1.0.0）
VERSION=""
# 时间戳标签格式（VERSION 为空时生效）
TAG_TIME_FORMAT="yyyyMMdd-HHmmss"
# 额外固定标签，逗号分隔；留空则只打主标签
EXTRA_TAGS="latest"
# 构建后是否推送：true / false
PUSH="true"

# ----- 本地 vue app（构建哪个）-----
APP_DIR="apps/paycardhub"
APP_PKG="@vben/paycardhub"

# ----- 前端构建参数（烤入镜像，覆盖该 app 的 .env.production）-----
VITE_GLOB_API_URL="http://paycardhub.v.m-tu.com"
VITE_OIDC_AUTHORITY="http://adminhost.v.m-tu.com"
VITE_OIDC_CLIENT_ID="paycardhub"
VITE_OIDC_REDIRECT_URI="http://paycardhubadmin.v.m-tu.com/auth/callback"
