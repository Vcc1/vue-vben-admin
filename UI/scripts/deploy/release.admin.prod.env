# ===== admin (MengtuAdmin) 前端 · 正式服务器 (prod) =====
# 命令：powershell -ExecutionPolicy Bypass -File scripts/deploy/build-and-push.ps1 -App admin -Target prod

# ----- 镜像 -----
DOCKER_REGISTRY="dockerhub.v.m-tu.com"
# 注意：仓库里已存在 web-adminui，推 latest 会覆盖现有标签，确认后再用
IMAGE_NAME="web-adminui"
VERSION=""
TAG_TIME_FORMAT="yyyyMMdd-HHmmss"
EXTRA_TAGS="latest"
PUSH="true"

# ----- 本地 vue app -----
APP_DIR="apps/admin"
APP_PKG="@vben/admin"

# ----- 前端构建参数 -----
# admin 的后端是 Admin.Host（dev 走 /api 代理到 :5100）。
# ！！待确认：生产 API base 是否为 http://adminhost.v.m-tu.com/api ！！
VITE_GLOB_API_URL="http://adminhost.v.m-tu.com/api"
# admin 生产 env 不使用 OIDC 变量，以下留空即不写入
VITE_OIDC_AUTHORITY=""
VITE_OIDC_CLIENT_ID=""
VITE_OIDC_REDIRECT_URI=""
